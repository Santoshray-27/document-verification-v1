PORT=4000
NODE_ENV=development
DB_PATH=./agnitia.db
JWT_SECRET=agnitia-dev-secret-change-me
JWT_EXPIRES_IN=12h
KEYS_DIR=../keys
STORAGE_DIR=./storage
PYTHON_WORKER_URL=http://127.0.0.1:8001
WORKER_TIMEOUT_MS=20000
PUBLIC_BASE_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=5
RATE_LIMIT_PUBLIC_WINDOW_MS=600000
RATE_LIMIT_PUBLIC_MAX=30
# Set to "true" ONLY while running tests/e2e.js. That suite deliberately exhausts the public
# limiter (test A23), which would otherwise starve later tests inside the same 10-min window.
RATE_LIMIT_DISABLED=false
DEMO_PASSWORD=Agnitia@123
