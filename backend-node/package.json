{
  "name": "agnitia-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Agnitia - Secure Digital Document Verification Platform (Node brain: DB, auth, crypto, verdict)",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "init": "node ../scripts/generate-keys.js && node ../scripts/init-db.js && node ../scripts/seed-demo.js",
    "test": "node --test ../tests/",
    "test:unit": "node --test ../tests/crypto.test.js ../tests/verdict.test.js",
    "test:e2e": "node ../tests/e2e.js"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.15.1"
  },
  "engines": {
    "node": ">=20"
  }
}