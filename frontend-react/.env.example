# Evidentia Frontend Environment Variables
# In development, the Vite proxy handles /api and /static automatically.
# In production, this should point to your real backend URL or remain /api if served from the same domain.
VITE_API_BASE_URL=/api

# ---------------------------------------------------------
# ⚠️ DEV-ONLY BANNER CONFIGURATION
# ---------------------------------------------------------
# Set to true to show a local development banner across the app
VITE_SHOW_DEV_BANNER=true
